generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  displayName  String
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  interactions Interaction[]

  @@map("users")
}

model Device {
  id           String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  displayName  String
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  lastSeenAt   DateTime?     @db.Timestamptz(3)
  interactions Interaction[]

  @@map("devices")
}

model Interaction {
  id             String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  deviceId       String              @db.Uuid
  userId         String              @db.Uuid
  device         Device              @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  user           User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  startedAt      DateTime            @default(now()) @db.Timestamptz(3)
  finishedAt     DateTime?           @db.Timestamptz(3)
  status         String
  inputAudioKey  String              @unique
  transcript     String?
  responseText   String?
  responseSource String?
  outputAudioKey String?
  error          String?
  actions        InteractionAction[]

  @@index([deviceId, startedAt])
  @@index([userId, startedAt])
  @@map("interactions")
}

model InteractionAction {
  id            String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  interactionId String      @db.Uuid
  interaction   Interaction @relation(fields: [interactionId], references: [id], onDelete: Cascade)
  sequence      Int
  initiator     String
  service       String
  operation     String
  arguments     Json        @db.JsonB
  result        Json?       @db.JsonB
  error         String?

  @@unique([interactionId, sequence])
  @@map("interactionActions")
}

// Voice terminals remain in Device. These models describe appliances in a home.
enum HomeDeviceKind {
  humidifier
  airMonitor
  breezer
}

enum DeviceRegistrationType {
  miioToken
  hommynShareUrl
}

model Home {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  displayName String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  rooms       Room[]

  @@map("homes")
}

model Room {
  id          String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  homeId      String       @db.Uuid
  displayName String
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  home        Home         @relation(fields: [homeId], references: [id], onDelete: Restrict)
  devices     HomeDevice[]

  @@index([homeId])
  @@map("rooms")
}

// Fixed model catalogue, populated by migrations, not by the device creation form.
model HomeDeviceType {
  id               String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code             String                 @unique
  displayName      String
  vendor           String
  model            String
  kind             HomeDeviceKind
  registrationType DeviceRegistrationType
  devices          HomeDevice[]

  @@map("homeDeviceTypes")
}

model HomeDevice {
  id               String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  roomId           String         @db.Uuid
  typeId           String         @db.Uuid
  displayName      String
  // Credentials included. Do not expose this field in device lists or LLM context.
  registrationData Json           @db.JsonB
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  room             Room           @relation(fields: [roomId], references: [id], onDelete: Restrict)
  type             HomeDeviceType @relation(fields: [typeId], references: [id], onDelete: Restrict)

  @@index([roomId])
  @@index([typeId])
  @@map("homeDevices")
}
