{
  "name": "friday-server",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "setup:whisper": "bash scripts/setup-whisper.sh",
    "setup:humidifier": "uv run scripts/humidifier-status.py --save-token",
    "voice": "node scripts/synthesize-reply.mjs",
    "send:wav": "tsx scripts/send-wav.ts",
    "test:whisper": "tsx scripts/smoke-whisper.ts",
    "prestart": "npm run db:deploy && npm run web:build",
    "predev": "npm run db:deploy && npm run web:build",
    "postinstall": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "web:build": "npm run build --workspace friday-web"
  },
  "dependencies": {
    "@fastify/static": "^10.1.12",
    "@fastify/websocket": "^11.2.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.10",
    "fastify": "^5.6.2",
    "prisma": "^7.10.1",
    "sherpa-onnx-node": "2.0.2",
    "uuid": "^13.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "ws": "^8.18.3"
  },
  "overrides": {
    "@prisma/config": {
      "effect": "3.22.5"
    }
  },
  "workspaces": [
    "web"
  ]
}
