{
  "name": "friday-server",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "setup:whisper": "bash scripts/setup-whisper.sh",
    "setup:home": "uv run scripts/home-miio.py --check && uv run scripts/home-syncleo.py --check",
    "voice": "node scripts/synthesize-reply.mjs",
    "send:wav": "tsx scripts/send-wav.ts",
    "test:whisper": "tsx scripts/smoke-whisper.ts",
    "prestart": "npm run db:deploy && npm run web:build",
    "predev": "npm run db:deploy && npm run web:build",
    "postinstall": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "web:build": "npm run build --workspace friday-web",
    "setup:ollama": "bash scripts/setup-ollama.sh",
    "llm:serve": "tsx scripts/ollama.ts serve",
    "llm:pull": "tsx scripts/ollama.ts pull",
    "test:assistant": "tsx scripts/smoke-assistant.ts",
    "test:home": "tsx scripts/smoke-home.ts",
    "test:ballu": "uv run --offline test/ballu.test.py",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write --error-on-warnings .",
    "format": "biome format --write .",
    "lint:staged": "lint-staged",
    "prepare": "cd .. && husky server/.husky"
  },
  "dependencies": {
    "@fastify/static": "^10.1.12",
    "@fastify/websocket": "^11.2.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.10",
    "fastify": "^5.6.2",
    "prisma": "^7.10.1",
    "sherpa-onnx-node": "2.0.2",
    "uuid": "^13.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@types/node": "^24.10.0",
    "@types/ws": "^8.18.1",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "ws": "^8.18.3"
  },
  "overrides": {
    "@prisma/config": {
      "effect": "3.22.5"
    }
  },
  "workspaces": [
    "web"
  ],
  "lint-staged": {
    "*": "biome check --write --error-on-warnings --no-errors-on-unmatched"
  }
}
