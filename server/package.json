{
  "name": "friday-server",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "start": "NODE_ENV=production tsx src/index.ts",
    "dev": "tsx src/index.ts --dev",
    "check": "tsc --noEmit",
    "test": "tsx --experimental-test-module-mocks --test test/*.test.ts",
    "setup:whisper": "bash scripts/setup-whisper.sh",
    "setup:home": "uv run scripts/home_syncleo.py --check",
    "voice": "node src/services/tts/supertonic.mjs",
    "send:wav": "tsx scripts/send-wav.ts",
    "test:whisper": "tsx --experimental-test-module-mocks scripts/smoke-whisper.ts",
    "db:deploy": "prisma db migrate && tsx scripts/seed-database.ts",
    "web:build": "npm run build",
    "setup:ollama": "bash scripts/setup-ollama.sh",
    "llm:serve": "tsx scripts/ollama.ts serve",
    "llm:pull": "tsx scripts/ollama.ts pull",
    "test:assistant": "tsx --experimental-test-module-mocks scripts/smoke-assistant.ts",
    "test:home": "tsx --experimental-test-module-mocks scripts/smoke-home.ts",
    "test:miio": "tsx --experimental-test-module-mocks --test test/miio.test.ts",
    "test:ballu": "uv run --offline test/test_ballu.py",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write --error-on-warnings .",
    "format": "biome format --write .",
    "lint:staged": "lint-staged",
    "prepare": "cd .. && husky server/.husky",
    "build": "next build",
    "db:emit": "prisma contract emit && node scripts/emit-device-model-code.ts",
    "stt:serve": "node --env-file-if-exists=.env --run stt:process",
    "stt:process": "bash scripts/start-whisper.sh"
  },
  "dependencies": {
    "@martyndevries/xiaomi-miio": "1.0.9",
    "@prisma/orm-postgres": "8.0.0-rc.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.10",
    "lucide-react": "^1.78.0",
    "next": "16.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sherpa-onnx-node": "2.0.2",
    "tailwind-merge": "^3.7.1",
    "tw-animate-css": "^1.4.0",
    "uuid": "^13.0.2",
    "ws": "^8.18.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "pg": "^8.23.1",
    "prisma": "8.0.0-rc.35",
    "shadcn": "4.23.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*": "biome check --write --error-on-warnings --no-errors-on-unmatched"
  }
}
